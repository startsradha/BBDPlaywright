{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "config/**/*.ts",
    "hooks/**/*.ts",
    "pages/**/*.ts",
    "step-definitions/**/*.ts",
    "test-runner/**/*.ts",
    "playwright.config.ts"
  ]
}
